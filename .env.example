# ==============================================================================
# INSAF JOB CIRCULAR — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local` with real secrets to version control.
# NEVER prefix secret server keys with `NEXT_PUBLIC_`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Insaf Job Circular"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTHENTICATION & STORAGE)
# ------------------------------------------------------------------------------
# Safe for browser (enforced by Supabase Row Level Security policies)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# SERVER-ONLY SECRET: Bypasses RLS. Used strictly in server-side admin/worker flows
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Storage bucket identifiers
SUPABASE_BUCKET_NOTICES="job-notices"
SUPABASE_BUCKET_LOGOS="organization-logos"
SUPABASE_BUCKET_ADS="insaf-ad-creatives"

# ------------------------------------------------------------------------------
# 3. REDIS & QUEUE INFRASTRUCTURE (SERVER & PYTHON WORKERS)
# ------------------------------------------------------------------------------
# Used for API rate-limiting, background job ingestion queue, and deduplication locks
REDIS_URL="redis://localhost:6379/0"
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-secret-token"

# ------------------------------------------------------------------------------
# 4. FIREBASE CLOUD MESSAGING (WEB PUSH NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Browser client configuration for PWA push subscription
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-web-push-vapid-public-key"

# SERVER-ONLY SECRET: Firebase Admin SDK credentials for dispatching notifications
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. PYTHON AUTOMATION WORKER & AI EXTRACTION (SERVER / WORKER ONLY)
# ------------------------------------------------------------------------------
# Shared HMAC secret between Python worker and Next.js webhook endpoints
WORKER_WEBHOOK_SECRET="generate-a-64-char-random-hex-secret"

# AI Provider key used by Python extraction worker for structured OCR/NLP parsing
AI_EXTRACTION_PROVIDER="gemini"
AI_EXTRACTION_API_KEY="your-ai-provider-secret-api-key"
AI_EXTRACTION_MODEL="gemini-2.5-flash"

# Worker polite crawling & compliance controls
WORKER_USER_AGENT="InsafJobCircularBot/1.0 (+https://insafjobcircular.com/bot-policy)"
WORKER_RESPECT_ROBOTS_TXT="true"
WORKER_MIN_REQUEST_DELAY_SECONDS="5"

# ------------------------------------------------------------------------------
# 6. SECURITY, RATE LIMITING & AUDIT LOGGING
# ------------------------------------------------------------------------------
RATE_LIMIT_PUBLIC_RPM="60"
RATE_LIMIT_ADMIN_RPM="120"
AUDIT_LOG_RETENTION_DAYS="365"
