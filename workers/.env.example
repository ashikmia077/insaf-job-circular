# Python Worker Environment Variables (.env.example)
REDIS_URL="redis://localhost:6379/0"
NEXTJS_WEBHOOK_URL="http://localhost:3000/api/v1/webhooks/worker"
WORKER_WEBHOOK_SECRET="generate-a-64-char-random-hex-secret"
AI_EXTRACTION_PROVIDER="gemini"
AI_EXTRACTION_API_KEY="your-ai-provider-secret-api-key"
AI_EXTRACTION_MODEL="gemini-2.5-flash"
WORKER_USER_AGENT="InsafJobCircularBot/1.0 (+https://insafjobcircular.com/bot-policy)"
WORKER_RESPECT_ROBOTS_TXT="true"
WORKER_MIN_REQUEST_DELAY_SECONDS="5"
